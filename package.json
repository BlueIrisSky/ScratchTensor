{
  "name": "scratch-tensor",
  "version": "0.1.2",
  "license": "MIT",
  "description": "ScratchTensor Core Engine with self-contained linear algebra components",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run bundle && npm run bundle:ext",
    "bundle": "esbuild src/index.ts --bundle --format=iife --global-name=ScratchTensor --outfile=dist/scratch-tensor.js",
    "bundle:ext": "esbuild src/scratch-extension.ts --bundle --format=iife --outfile=dist/scratch-tensor-extension.js",
    "bundle:min": "esbuild src/scratch-extension.ts --bundle --format=iife --minify --outfile=dist/scratch-tensor-extension.min.js",
    "test": "vitest run",
    "test:scratchdsl": "node --test --test-concurrency=1 test/scratchdsl/docs.check.mjs test/scratchdsl/runtime.check.mjs test/scratchdsl/boundaries.check.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:verify": "node scripts/release.mjs verify"
  },
  "devDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@turbowarp/jszip": "3.12.0",
    "@turbowarp/scratch-svg-renderer": "1.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "scratch-render-fonts": "https://codeload.github.com/TurboWarp/scratch-render-fonts/tar.gz/7b6768fc6dfef6b343a06f992587b74807043961",
    "scratch-vm": "https://codeload.github.com/TurboWarp/scratch-vm/tar.gz/e9c6e122bff25a13b57059e4fd32544e7d9560ca",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "scratch-parser": "https://codeload.github.com/TurboWarp/scratch-parser/tar.gz/fb65ba09d78ab6a0d19ce908d64b72d1a122312f",
    "scratch-render-fonts": "$scratch-render-fonts"
  }
}
